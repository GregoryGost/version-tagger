#!/usr/bin/env bash
set -euo pipefail

# Only the newest stable v1 release on main may move the major alias.
release_tag="${1:-}"
if [[ ! "$release_tag" =~ ^v1\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
	echo "Skipping major alias for non-stable-v1 tag: $release_tag"
	exit 0
fi

latest_tag="$(
	git ls-remote --refs --tags origin 'refs/tags/v1.*' |
		awk '{print $2}' |
		sed 's#^refs/tags/##' |
		grep -E '^v1\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' |
		sort -V |
		tail -n 1
)"
if [[ "$latest_tag" != "$release_tag" ]]; then
	echo "Skipping $release_tag: newest stable v1 release is $latest_tag"
	exit 0
fi

git fetch --no-tags origin "refs/tags/$release_tag"
target_sha="$(git rev-parse --verify 'FETCH_HEAD^{commit}')"
git fetch --no-tags origin main
if ! git merge-base --is-ancestor "$target_sha" FETCH_HEAD; then
	echo "Refusing to point v1 at a release outside origin/main" >&2
	exit 1
fi

existing_ref="$(git ls-remote --refs origin refs/tags/v1 | awk '{print $1}')"
if [[ -n "$existing_ref" ]]; then
	git fetch --no-tags origin refs/tags/v1
	current_sha="$(git rev-parse --verify 'FETCH_HEAD^{commit}')"
	if [[ "$current_sha" == "$target_sha" ]]; then
		echo "v1 already points at $release_tag ($target_sha)"
		exit 0
	fi
fi

# A stale workflow cannot overwrite a concurrently updated ref.
git push --force-with-lease="refs/tags/v1:$existing_ref" origin "$target_sha:refs/tags/v1"
echo "Updated v1 to $release_tag ($target_sha)"
