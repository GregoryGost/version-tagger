{
  "name": "@gregory-gost/version-tagger",
  "version": "1.1.0",
  "description": "GitHub Action to automate tag-based version control. For both production and development.",
  "license": "GPL-3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GregoryGost/version-tagger.git"
  },
  "bugs": {
    "url": "https://github.com/GregoryGost/version-tagger/issues"
  },
  "homepage": "https://github.com/GregoryGost/version-tagger",
  "keywords": [
    "gregory-gost",
    "typescript",
    "github-actions",
    "actions",
    "node",
    "nodejs",
    "tagger",
    "tag",
    "development-tag",
    "dev"
  ],
  "author": {
    "name": "Grigoriy Schetintsev (GregoryGost)",
    "email": "info@gregory-gost.ru"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": "^20.19.0 || >=24.13.0"
  },
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "pnpm jest",
    "coverage": "pnpm make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint -c eslint.config.mjs .",
    "lint:debug": "pnpm eslint --debug -c eslint.config.mjs .",
    "package": "pnpm tsup",
    "all": "pnpm run format:write && pnpm run lint && pnpm run ci-test && pnpm run coverage && pnpm run package",
    "check-lib": "pnpm outdated"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@eslint/js": "9.39.3",
    "@jest/globals": "30.4.1",
    "@octokit/core": "7.0.6",
    "@octokit/plugin-rest-endpoint-methods": "17.0.0",
    "@octokit/types": "16.0.0",
    "@tsconfig/node24": "24.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-github": "6.0.0",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-jsonc": "3.2.0",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "make-coverage-badge": "1.2.0",
    "prettier": "3.8.3",
    "prettier-eslint": "16.4.2",
    "semver": "7.8.1",
    "ts-jest": "29.4.11",
    "tsup": "8.5.1",
    "type-fest": "5.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
