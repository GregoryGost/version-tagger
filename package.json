{
  "name": "@gregory-gost/version-tagger",
  "version": "1.0.6",
  "description": "GitHub Action to automate tag-based version control. For both production and development.",
  "license": "GPL-3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GregoryGost/version-tagger.git"
  },
  "bugs": {
    "url": "https://github.com/GregoryGost/version-tagger/issues"
  },
  "homepage": "https://github.com/GregoryGost/version-tagger",
  "keywords": [
    "gregory-gost",
    "typescript",
    "github-actions",
    "actions",
    "node",
    "nodejs",
    "tagger",
    "tag",
    "development-tag",
    "dev"
  ],
  "author": {
    "name": "Grigoriy Schetintsev (GregoryGost)",
    "email": "info@gregory-gost.ru"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "pnpm jest",
    "coverage": "pnpm make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint -c eslint.config.mjs .",
    "lint:debug": "pnpm eslint --debug -c eslint.config.mjs .",
    "package": "pnpm tsup",
    "all": "pnpm run format:write && pnpm run lint && pnpm run ci-test && pnpm run coverage && pnpm run package",
    "check-lib": "pnpm outdated"
  },
  "devDependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.1",
    "@eslint/js": "9.27.0",
    "@jest/globals": "29.7.0",
    "@octokit/core": "6.1.4",
    "@octokit/plugin-rest-endpoint-methods": "13.3.1",
    "@octokit/types": "13.8.0",
    "@tsconfig/node20": "20.1.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.21",
    "@types/semver": "7.7.0",
    "eslint": "9.27.0",
    "eslint-plugin-github": "5.1.8",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-jsonc": "2.20.1",
    "eslint-plugin-prettier": "5.4.0",
    "globals": "16.1.0",
    "jest": "29.7.0",
    "make-coverage-badge": "1.2.0",
    "prettier": "3.5.3",
    "semver": "7.7.2",
    "ts-jest": "29.3.4",
    "tsup": "8.5.0",
    "type-fest": "4.41.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
